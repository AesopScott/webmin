# GitHub API — personal access token with repo read/write scope
GITHUB_TOKEN=your_github_personal_access_token
GITHUB_OWNER=AesopScott
GITHUB_REPO=cmc

# Auth — long random string (e.g. openssl rand -hex 32)
JWT_SECRET=your_long_random_secret_here

# User password hashes — generate with: node server/scripts/hash-password.js <password>
AALBAHAR_PASSWORD_HASH=
FCARRANZA_PASSWORD_HASH=
KFIELD_PASSWORD_HASH=
MOLAGE_PASSWORD_HASH=
SSCHINDLER_PASSWORD_HASH=
STAFT_PASSWORD_HASH=
TECH_PASSWORD_HASH=

# Server
PORT=3001
